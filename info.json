{
  "$schema": "https://raw.githubusercontent.com/Chatterino/chatterino2/master/docs/plugin-info.schema.json",
  "name": "Chatterino Pronouns",
  "description": "Shows alejo.io and PronounDB pronouns directly in chat. Each user is looked up at most once per day (cached on disk).",
  "authors": ["natit"],
  "homepage": "https://github.com/natiT/chatterino-pronouns",
  "tags": ["pronouns"],
  "version": "1.1.0",
  "license": "MIT",
  "permissions": [
    { "type": "Network" },
    { "type": "FilesystemRead" },
    { "type": "FilesystemWrite" }
  ]
}
